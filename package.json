{
  "name": "vltra",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "24.x"
  },
  "portless": "vltra",
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --max-warnings 0 .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:lint": "vitest run --project unit tools/oxlint/anti-slop.test.js eslint-local-rules/rules.test.js",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test --run && pnpm build",
    "ship": "pnpm build && systemctl --user restart vltra",
    "vltra:import-handled": "tsx scripts/import-handled.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@effect/platform-node": "4.0.0-rc.112",
    "@opencode/client": "2.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.112",
    "lucide-react": "^1.23.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "4.0.0-rc.112",
    "@opencode/protocol": "2.0.20",
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "portless": "^0.15.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
